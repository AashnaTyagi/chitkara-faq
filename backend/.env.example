# Copy to .env (never commit .env).
FOUNDRY_PROJECT_ENDPOINT=https://uniassist-resource.services.ai.azure.com/api/projects/uniassist
MODEL_DEPLOYMENT_NAME=gpt-5-mini
MAIN_AGENT_NAME=chitkara-main-agent
KB_AGENT_NAME=chitkara-kb-agent

# Show "how this was answered" (the question sent to the KB agent) in the chat UI
SHOW_AGENT_TRACE=true
# Per-visitor message limit, protects your Azure credits once the site is public
MAX_REQUESTS_PER_MINUTE=15
# Only needed if the frontend is hosted on a different domain than the backend
ALLOWED_ORIGINS=

# ---- Only for hosting (Render). Leave empty locally: `az login` is used instead. ----
# A service principal with the "Azure AI User" (Foundry User) role on uniassist-resource.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
