{
  "framework": null,
  "outputDirectory": "frontend",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,knowledge-base/**,render.yaml,README.md,.gitignore}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" }
  ]
}